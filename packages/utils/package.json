{
  "name": "@puregram/utils",
  "version": "3.1.0",
  "description": "small standalone utilities for puregram — slot-machine value decoder + telegram web app initData validation",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "rm -rf lib && tsc --project tsconfig.json && tsc-alias -p tsconfig.json --resolve-full-paths",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "tsc-alias": "1",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "license": "MPL-2.0",
  "author": "starkow",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/puregram/puregram",
    "directory": "packages/utils"
  },
  "keywords": [
    "telegram",
    "telegram-bot-api",
    "puregram",
    "utils",
    "web-app",
    "casino"
  ]
}
