{
  "name": "@puregram/scenes",
  "version": "3.0.0",
  "description": "multi-step scene/wizard plugin for puregram",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "rm -rf lib && tsc --project tsconfig.json && tsc-alias -p tsconfig.json --resolve-full-paths",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:augmentations": "tsx scripts/emit-augmentations.ts"
  },
  "dependencies": {
    "@puregram/api": "workspace:~",
    "@puregram/session": "workspace:^",
    "puregram": "workspace:^"
  },
  "devDependencies": {
    "tsc-alias": "1",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "license": "MPL-2.0",
  "author": "starkow",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/puregram/puregram",
    "directory": "packages/scenes"
  },
  "keywords": [
    "telegram",
    "telegram-bot-api",
    "puregram",
    "plugin",
    "scenes",
    "wizard"
  ]
}
