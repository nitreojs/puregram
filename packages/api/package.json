{
  "name": "@puregram/api",
  "version": "10.2.3",
  "description": "autogenerated bot api types, structures, updates, factories for puregram",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/generated/types.d.ts",
      "import": "./lib/generated/types.js",
      "default": "./lib/generated/types.js"
    }
  },
  "files": [
    "lib",
    "schema/*.json"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "rm -rf lib && tsc --project tsconfig.json && tsc-alias -p tsconfig.json --resolve-full-paths",
    "test": "vitest run",
    "test:watch": "vitest",
    "parse": "tsx scripts/parse.ts",
    "emit": "tsx scripts/emit.ts",
    "verify": "tsx scripts/verify.ts",
    "emit:docs": "tsx scripts/docs.ts",
    "regenerate": "yarn parse && yarn emit"
  },
  "devDependencies": {
    "cheerio": "^1.0.0",
    "tsc-alias": "1",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "undici": "^6.0.0",
    "vitest": "^1.4.0"
  },
  "license": "MPL-2.0",
  "author": "starkow",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://puregram.cool/docs",
  "bugs": {
    "url": "https://github.com/puregram/puregram/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/puregram/puregram",
    "directory": "packages/api"
  }
}
