{
  "name": "puregram",
  "version": "3.10.0",
  "description": "powerful and modern telegram bot api sdk for node.js and typescript 😁",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./keyboards": {
      "types": "./lib/keyboards/index.d.ts",
      "import": "./lib/keyboards/index.js",
      "default": "./lib/keyboards/index.js"
    },
    "./parse-mode": {
      "types": "./lib/parse-mode/index.d.ts",
      "import": "./lib/parse-mode/index.js",
      "default": "./lib/parse-mode/index.js"
    },
    "./filters": {
      "types": "./lib/filters/index.d.ts",
      "import": "./lib/filters/index.js",
      "default": "./lib/filters/index.js"
    },
    "./plugin": {
      "types": "./lib/plugins/plugin.d.ts",
      "import": "./lib/plugins/plugin.js",
      "default": "./lib/plugins/plugin.js"
    },
    "./webhook": {
      "types": "./lib/transport/webhook/index.d.ts",
      "import": "./lib/transport/webhook/index.js",
      "default": "./lib/transport/webhook/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "rm -rf lib && tsc --project tsconfig.json && tsc-alias -p tsconfig.json --resolve-full-paths",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@puregram/api": "workspace:*",
    "form-data-encoder": "^4.0.2",
    "formdata-node": "^6.0.3"
  },
  "devDependencies": {
    "tsc-alias": "1",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "license": "MPL-2.0",
  "author": "starkow",
  "homepage": "https://puregram.cool/docs",
  "bugs": {
    "url": "https://github.com/puregram/puregram/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/puregram/puregram",
    "directory": "packages/puregram"
  },
  "keywords": [
    "telegram",
    "telegram-api",
    "telegram-bot-api",
    "bot api",
    "bot",
    "typescript"
  ]
}
