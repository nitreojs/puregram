{
  "name": "puregram-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/storage/storages/*",
    "docs",
    "examples",
    "examples/webhooks/*",
    "examples/recipes/*"
  ],
  "devDependencies": {
    "@commitlint/cli": "^17.0.3",
    "@commitlint/config-conventional": "^17.0.3",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.20.0",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-local-rules": "^3.0.2",
    "eslint-plugin-n": "^16.0.0",
    "eslint-plugin-promise": "^6.0.0",
    "husky": "^8.0.1",
    "lint-staged": "^17.0.5",
    "tsx": "^4.19.0",
    "typescript": "^5.3.3"
  },
  "scripts": {
    "prepare": "husky install",
    "build": "yarn workspaces foreach -Apt run build",
    "lint": "eslint packages/*/src packages/storage/storages/*/src packages/*/scripts",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "yarn workspaces foreach -A run test",
    "clean": "yarn workspaces foreach -A run clean",
    "regenerate-all": "tsx scripts/regenerate-all.ts",
    "release": "yarn build && yarn workspaces foreach -At --no-private npm publish --tolerate-republish"
  },
  "lint-staged": {
    "{packages/*/src,packages/storage/storages/*/src,packages/*/scripts}/**/*.ts": "eslint"
  },
  "packageManager": "yarn@4.5.0+sha512.837566d24eec14ec0f5f1411adb544e892b3454255e61fdef8fd05f3429480102806bac7446bc9daff3896b01ae4b62d00096c7e989f1596f2af10b927532f39"
}
