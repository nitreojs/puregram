{
  "name": "@puregram/stream",
  "version": "3.2.0",
  "description": "stream LLM output to telegram via sendMessageDraft + finalize sendMessage",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "rm -rf lib && tsc --project tsconfig.json && tsc-alias -p tsconfig.json --resolve-full-paths",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "puregram": "workspace:^"
  },
  "peerDependencies": {
    "@puregram/markup": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@puregram/markup": {
      "optional": true
    }
  },
  "devDependencies": {
    "@puregram/markup": "workspace:^",
    "tsc-alias": "1",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "license": "MPL-2.0",
  "author": "starkow",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://puregram.cool/docs",
  "bugs": {
    "url": "https://github.com/puregram/puregram/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/puregram/puregram",
    "directory": "packages/stream"
  },
  "keywords": [
    "telegram",
    "telegram-bot-api",
    "puregram",
    "plugin",
    "stream",
    "streaming",
    "llm",
    "openai",
    "anthropic"
  ]
}
