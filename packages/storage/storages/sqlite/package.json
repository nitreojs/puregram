{
  "name": "@puregram/storage-sqlite",
  "version": "3.0.0",
  "description": "sqlite-backed KVStorage adapter for puregram with native ttl via better-sqlite3",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "rm -rf lib && tsc --project tsconfig.json && tsc-alias -p tsconfig.json --resolve-full-paths",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@puregram/storage": "workspace:^"
  },
  "peerDependencies": {
    "better-sqlite3": "^11.0.0"
  },
  "devDependencies": {
    "tsc-alias": "1",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "license": "MPL-2.0",
  "author": "starkow",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://puregram.cool/docs",
  "bugs": {
    "url": "https://github.com/puregram/puregram/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/puregram/puregram",
    "directory": "packages/storage/storages/sqlite"
  },
  "keywords": [
    "telegram",
    "telegram-bot-api",
    "puregram",
    "storage",
    "sqlite",
    "better-sqlite3",
    "kv"
  ]
}
