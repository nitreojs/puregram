{
  "name": "@puregram/markup",
  "version": "3.0.0-alpha.0",
  "description": "entity-based text formatting plugin for puregram v3",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": ["lib"],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "rm -rf lib && tsc --project tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "puregram": "3.0.0-alpha.0",
    "@puregram/api": "*"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "license": "WTFPL",
  "author": "starkow",
  "repository": {
    "type": "git",
    "url": "https://github.com/nitreojs/puregram",
    "directory": "packages/markup"
  },
  "keywords": ["telegram", "telegram-bot-api", "puregram", "plugin", "markup", "formatting"]
}
